# Copy required values into local .env.local or the Vercel project settings.
# Never commit real credentials.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# Optional OpenAI-compatible provider settings.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-luna

# Telegram/Vercel webhook deployment.
# Enable on Vercel after applying schema-proposals/vercel-webhook-storage.sql.
# TELEGRAM_SESSION_STORE=supabase
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
CRON_SECRET=

# Planner scheduler settings.
PLANNER_TIMEZONE=Europe/Moscow
MORNING_SUMMARY_ENABLED=false
MORNING_SUMMARY_HOUR=8
MORNING_SUMMARY_MINUTE=0
MORNING_SUMMARY_WINDOW_MINUTES=60
REMINDER_BATCH_SIZE=50
